          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('SERVICE_UNAVAILABLE con service', () => {",
                  "  pm.expect(body.error).to.eql('SERVICE_UNAVAILABLE');",
